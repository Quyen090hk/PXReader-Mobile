{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxreader.app/protocol/v1/annotation.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "documentId", "quote", "color", "locator", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "format": "uuid" },
    "documentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "quote": { "type": "string", "minLength": 1 },
    "note": { "type": ["string", "null"] },
    "color": { "enum": ["yellow", "green", "blue", "pink", "orange"] },
    "locator": { "$ref": "backup.schema.json#/$defs/textLocator" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

