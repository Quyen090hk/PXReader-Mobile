{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pxreader.app/protocol/v1/backup.schema.json",
  "type": "object",
  "required": ["schemaVersion", "kind", "exportedAt", "documents", "positions", "bookmarks", "annotations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "pxreader-backup" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "enum": ["android", "harmony"] },
    "documents": { "type": "array", "items": { "$ref": "document.schema.json" } },
    "positions": { "type": "array", "items": { "$ref": "position.schema.json" } },
    "bookmarks": { "type": "array", "items": { "$ref": "bookmark.schema.json" } },
    "annotations": { "type": "array", "items": { "$ref": "annotation.schema.json" } }
  },
  "$defs": {
    "textLocator": {
      "type": "object",
      "required": ["kind", "chapterIndex", "chapterHref", "charStart", "charEnd", "progress", "quote", "prefix", "suffix"],
      "properties": {
        "kind": { "const": "text" },
        "chapterIndex": { "type": "integer", "minimum": 0 },
        "chapterHref": { "type": ["string", "null"] },
        "charStart": { "type": "integer", "minimum": 0 },
        "charEnd": { "type": "integer", "minimum": 0 },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "quote": { "type": "string" },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "anchor": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

